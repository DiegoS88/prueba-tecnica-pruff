<div class="auth-wrap">
  <div class="auth-card">
    <h1 class="auth-title">Cartera</h1>
    <p class="auth-sub">Ingresa para acceder al panel de factoring</p>

    <% if alert %><p class="alert"><%= alert %></p><% end %>
    <% if notice %><p class="notice"><%= notice %></p><% end %>

    <%= form_with url: session_path, class: "auth-form" do |form| %>
      <div class="field">
        <%= form.label :email_address, "Correo electrónico" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "tu@empresa.cl", value: params[:email_address] %>
      </div>
      <div class="field">
        <%= form.label :password, "Contraseña" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72 %>
      </div>
      <%= form.submit "Ingresar", class: "btn btn-primary auth-submit" %>
    <% end %>

    <p class="auth-links"><%= link_to "¿Olvidaste tu contraseña?", new_password_path %></p>
  </div>
</div>
