<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Cartera | Factoring" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a href="<%= root_path %>" class="brand">Cartera</a>
        <% if authenticated? %>
          <nav class="nav">
            <%= link_to "Dashboard", root_path %>
            <%= link_to "Facturas", invoices_path %>
            <%= link_to "Movimientos", movements_path %>
            <%= link_to "Conciliación", reconciliation_index_path %>
            <%= link_to "Importar", imports_path %>
          </nav>
          <div class="user">
            <span><%= Current.user.email_address %></span>
            <%= button_to "Salir", session_path, method: :delete, class: "logout-btn" %>
          </div>
        <% end %>
      </div>
    </header>

    <main class="container">
      <% if notice %><p class="notice"><%= notice %></p><% end %>
      <% if alert %><p class="alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>